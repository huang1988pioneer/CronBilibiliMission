<!--
THESIS: A two-pane secrets console, not a stack of equal cards.
OWN-WORLD: Cool paper #E7E9ED, ink #1A1D23, one Bilibili rose accent on primary actions only.
STORY: Drop a cookies.txt, read three secrets, copy or push them to GitHub Actions.
FIRST VIEWPORT: Left = file drop + expiry + GitHub form. Right = the three values. Status bar pinned.
FORM: Operate / distilled workbench. FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BilibiliCookieReader.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1080"
        d:DesignHeight="720"
        x:Class="BilibiliCookieReader.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Width="1080"
        Height="740"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#E7E9ED"
        DragDrop.AllowDrop="True">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding BrowseCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding LoadCommand}" />
  </Window.KeyBindings>

  <DockPanel>
    <Border DockPanel.Dock="Bottom"
            Background="#F7F8FA"
            BorderBrush="#C9CED6"
            BorderThickness="0,1,0,0"
            Padding="24,10">
      <TextBlock Text="{Binding StatusMessage}"
                 TextWrapping="Wrap"
                 FontSize="12"
                 Classes.error="{Binding IsError}"
                 Classes.ok="{Binding !IsError}" />
    </Border>

    <Grid Margin="24" RowDefinitions="Auto,*" RowSpacing="20">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="6">
          <TextBlock Classes="title" Text="Bilibili Cookie 讀取器" />
          <TextBlock Classes="muted"
                     FontSize="13"
                     Text="讀取 cookies.txt，取出 SESSDATA、BILI_JCT、DEDEUSERID。"
                     TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Column="1" Classes="chip" VerticalAlignment="Top">
          <TextBlock Text="不要提交 Cookie"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="#9B1B4A" />
        </Border>
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="340,*" ColumnSpacing="20">
        <ScrollViewer>
          <StackPanel Spacing="16">
            <Border x:Name="DropZone" Classes="dropzone">
              <StackPanel Spacing="10">
                <TextBlock Classes="section" Text="Cookie 檔" />
                <TextBlock Classes="muted"
                           FontSize="12"
                           Text="拖放 Netscape .txt，或瀏覽後按讀取。只取 .bilibili.com。"
                           TextWrapping="Wrap" />
                <TextBox x:Name="PathBox"
                         Text="{Binding CookiePath}"
                         PlaceholderText="cookies.txt 路徑"
                         VerticalContentAlignment="Center"
                         KeyDown="OnPathKeyDown" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Button Classes="secondary"
                          Content="瀏覽"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center"
                          Command="{Binding BrowseCommand}"
                          ToolTip.Tip="Ctrl+O" />
                  <Button Grid.Column="1"
                          Classes="primary"
                          Content="讀取"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center"
                          Command="{Binding LoadCommand}"
                          ToolTip.Tip="F5" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="expiry"
                    Classes.ok="{Binding IsExpiryOk}"
                    Classes.soon="{Binding IsExpirySoon}"
                    Classes.urgent="{Binding IsExpiryUrgent}"
                    Classes.expired="{Binding IsExpiryExpired}"
                    IsVisible="{Binding HasExpiryReminder}">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding ExpiryTitle}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding ExpiryDetail}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Opacity="0.9" />
              </StackPanel>
            </Border>

            <Border Classes="panel">
              <StackPanel Spacing="10">
                <TextBlock Classes="section" Text="更新 GitHub Secrets" />
                <TextBlock Classes="muted"
                           FontSize="12"
                           Text="寫入 SESSDATA、BILI_JCT、DEDEUSERID。需要能改 Actions Secrets 的權杖。"
                           TextWrapping="Wrap" />
                <TextBlock Classes="muted" FontSize="12" Text="Repo" />
                <TextBox Text="{Binding GitHubRepo}"
                         PlaceholderText="owner/name"
                         VerticalContentAlignment="Center" />
                <TextBlock Classes="muted" FontSize="12" Text="權杖" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Text="{Binding GitHubToken}"
                           PasswordChar="•"
                           PlaceholderText="ghp_… 或 github_pat_…"
                           VerticalContentAlignment="Center" />
                  <Button Grid.Column="1"
                          Classes="secondary"
                          Content="gh 權杖"
                          Command="{Binding UseGhTokenCommand}" />
                </Grid>
                <CheckBox Content="記住權杖（只存在本機）"
                          FontSize="12"
                          IsChecked="{Binding RememberGitHubToken}" />
                <CheckBox Content="確定覆寫這三個 Secrets"
                          FontSize="12"
                          IsChecked="{Binding ConfirmOverwriteSecrets}" />
                <Button Classes="primary"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Content="更新 GitHub Secrets"
                        Command="{Binding UpdateGitHubSecretsCommand}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Classes="panel" Padding="8,8,8,16">
          <DockPanel>
            <Grid DockPanel.Dock="Bottom" Margin="12,12,12,4">
              <StackPanel Spacing="8">
                <WrapPanel ItemSpacing="6" LineSpacing="6">
                  <Button Classes="secondary"
                          Content="{Binding RevealButtonText}"
                          Command="{Binding ToggleRevealCommand}" />
                  <Button Classes="primary"
                          Content="驗證登入"
                          Command="{Binding VerifyLoginCommand}" />
                </WrapPanel>
                <WrapPanel ItemSpacing="2" LineSpacing="4">
                  <Button Classes="ghost"
                          Content="複製環境變數"
                          Command="{Binding CopyAllEnvCommand}" />
                  <Button Classes="ghost"
                          Content="複製 Secrets"
                          Command="{Binding CopyAllSecretsCommand}" />
                  <Button Classes="ghost"
                          Content="複製 Cookie 字串"
                          Command="{Binding CopyCookieHeaderCommand}" />
                  <Button Classes="ghost"
                          Content="PowerShell"
                          Command="{Binding CopyPowerShellCommand}" />
                  <Button Classes="ghost"
                          Content="bash"
                          Command="{Binding CopyBashCommand}" />
                </WrapPanel>
                <TextBlock Classes="muted"
                           FontSize="11"
                           Text="SESSDATA 保持檔案原始值，不要 URL 解碼。更新 Secrets 無法讀回舊值。"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Grid>

            <Grid>
              <StackPanel Margin="16"
                          Spacing="8"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsVisible="{Binding !HasResult}">
                <TextBlock Text="還沒有 Cookie"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Classes="muted"
                           FontSize="13"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="320"
                           Text="把瀏覽器匯出的 cookies.txt 拖到左邊，或按瀏覽。" />
              </StackPanel>

              <ItemsControl ItemsSource="{Binding Fields}"
                            Margin="12,4"
                            IsVisible="{Binding HasResult}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CookieFieldViewModel">
                    <Border Classes="row">
                      <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding EnvName}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Classes="muted"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Text="{Binding SecretHint}" />
                          </StackPanel>
                          <Button Grid.Column="1"
                                  Classes="secondary"
                                  Content="複製"
                                  Command="{Binding CopyCommand}"
                                  IsEnabled="{Binding HasValue}" />
                        </Grid>
                        <TextBox Classes="mono"
                                 Text="{Binding DisplayValue}"
                                 IsReadOnly="True"
                                 AcceptsReturn="False" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                          <TextBlock Classes="muted" FontSize="12" Text="{Binding MetaText}" />
                          <TextBlock Classes="warn"
                                     FontSize="12"
                                     Text="即將到期"
                                     IsVisible="{Binding IsExpiringSoon}" />
                          <TextBlock Classes="error"
                                     FontSize="12"
                                     Text="已過期"
                                     IsVisible="{Binding IsExpired}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
