<!--
THESIS: A two-pane secrets console, not a stack of equal cards.
OWN-WORLD: Cool paper #E7E9ED, ink #1A1D23, one Bilibili rose accent on primary actions only.
STORY: Drop a cookies.txt, read four secrets, copy or push them to GitHub Actions.
FIRST VIEWPORT: Left = file drop + expiry + GitHub form. Right = the four values. Status bar pinned.
FORM: Operate / distilled workbench. FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BilibiliCookieReader.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1080"
        d:DesignHeight="720"
        x:Class="BilibiliCookieReader.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Width="1080"
        Height="740"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#E7E9ED"
        DragDrop.AllowDrop="True">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding BrowseCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding LoadCommand}" />
  </Window.KeyBindings>

  <DockPanel>
    <Border DockPanel.Dock="Bottom"
            Background="#F7F8FA"
            BorderBrush="#C9CED6"
            BorderThickness="0,1,0,0"
            Padding="24,10">
      <TextBlock Text="{Binding StatusMessage}"
                 TextWrapping="Wrap"
                 FontSize="12"
                 Classes.error="{Binding IsError}"
                 Classes.ok="{Binding !IsError}" />
    </Border>

    <Grid Margin="24" RowDefinitions="Auto,*" RowSpacing="20">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
        <StackPanel Spacing="6">
          <TextBlock Classes="title" Text="Bilibili Cookie 讀取器" />
          <TextBlock Classes="muted"
                     FontSize="13"
                     Text="讀取 cookies.txt，取出 SESSDATA、BILI_JCT、DEDEUSERID、BUVID3。"
                     TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Column="1" Classes="chip" VerticalAlignment="Top">
          <TextBlock Text="不要提交 Cookie"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="#9B1B4A" />
        </Border>
        <Border Grid.Row="1"
                Grid.ColumnSpan="2"
                Background="#F7F8FA"
                CornerRadius="8"
                Padding="10,7">
          <StackPanel Spacing="3">
            <TextBlock Text="{Binding BackgroundHotSearchStatus}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Classes.error="{Binding IsBackgroundHotSearchError}"
                       Classes.ok="{Binding !IsBackgroundHotSearchError}" />
            <TextBlock Text="{Binding BackgroundRankingStatus}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Classes.error="{Binding IsBackgroundRankingError}"
                       Classes.ok="{Binding !IsBackgroundRankingError}" />
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="340,*" ColumnSpacing="20">
        <ScrollViewer>
          <StackPanel Spacing="16">
            <Border x:Name="DropZone" Classes="dropzone">
              <StackPanel Spacing="10">
                <TextBlock Classes="section" Text="Bilibili 帳號" />
                <ComboBox ItemsSource="{Binding Accounts}"
                          SelectedItem="{Binding SelectedAccount}"
                          HorizontalAlignment="Stretch"
                          MinHeight="36">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:BilibiliAccountOption">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Separator Margin="0,4" />
                <TextBlock Classes="section" Text="Cookie 檔" />
                <TextBlock Classes="muted"
                           FontSize="12"
                           Text="拖放 Netscape .txt，或瀏覽後按讀取。只取 .bilibili.com。"
                           TextWrapping="Wrap" />
                <TextBox x:Name="PathBox"
                         Text="{Binding CookiePath}"
                         PlaceholderText="cookies.txt 路徑"
                         VerticalContentAlignment="Center"
                         KeyDown="OnPathKeyDown" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Button Classes="secondary"
                          Content="瀏覽"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center"
                          Command="{Binding BrowseCommand}"
                          ToolTip.Tip="Ctrl+O" />
                  <Button Grid.Column="1"
                          Classes="primary"
                          Content="讀取"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center"
                          Command="{Binding LoadCommand}"
                          ToolTip.Tip="F5" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="expiry"
                    Classes.ok="{Binding IsExpiryOk}"
                    Classes.soon="{Binding IsExpirySoon}"
                    Classes.urgent="{Binding IsExpiryUrgent}"
                    Classes.expired="{Binding IsExpiryExpired}"
                    IsVisible="{Binding HasExpiryReminder}">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding ExpiryTitle}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding ExpiryDetail}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Opacity="0.9" />
              </StackPanel>
            </Border>

            <Border Classes="panel">
              <StackPanel Spacing="10">
                <TextBlock Classes="section" Text="更新 GitHub Secrets" />
                <TextBlock Classes="muted"
                           FontSize="12"
                           Text="需要能修改 Actions Secrets 的 GitHub 權杖。"
                           TextWrapping="Wrap" />
                <TextBlock FontSize="12"
                           FontWeight="SemiBold"
                           Text="{Binding SelectedAccount.DisplayName}" />
                <TextBlock Classes="muted"
                           FontSize="11"
                           Text="{Binding SelectedSecretNames}"
                           TextWrapping="Wrap" />
                <TextBlock Classes="muted" FontSize="12" Text="Repo" />
                <TextBox Text="{Binding GitHubRepo}"
                         PlaceholderText="owner/name"
                         VerticalContentAlignment="Center" />
                <TextBlock Classes="muted" FontSize="12" Text="權杖" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Text="{Binding GitHubToken}"
                           PasswordChar="•"
                           PlaceholderText="ghp_… 或 github_pat_…"
                           VerticalContentAlignment="Center" />
                  <Button Grid.Column="1"
                          Classes="secondary"
                          Content="gh 權杖"
                          Command="{Binding UseGhTokenCommand}" />
                </Grid>
                <CheckBox Content="記住權杖（只存在本機）"
                          FontSize="12"
                          IsChecked="{Binding RememberGitHubToken}" />
                <CheckBox Content="確定覆寫這四個 Secrets"
                          FontSize="12"
                          IsChecked="{Binding ConfirmOverwriteSecrets}" />
                <Button Classes="primary"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Content="更新 GitHub Secrets"
                        Command="{Binding UpdateGitHubSecretsCommand}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Classes="panel" Padding="8,8,8,16">
          <DockPanel>
            <ScrollViewer DockPanel.Dock="Top"
                          MaxHeight="340"
                          VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding HasAccountStatus}">
            <Border Classes="accountstatus"
                    Margin="12,4,12,8">
              <Grid ColumnDefinitions="*,Auto"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                    ColumnSpacing="20"
                    RowSpacing="8">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="10"
                      VerticalAlignment="Center">
                  <Ellipse Width="44"
                           Height="44"
                           IsVisible="{Binding HasAccountAvatar}">
                    <Ellipse.Fill>
                      <ImageBrush Source="{Binding AccountAvatar}"
                                  Stretch="UniformToFill" />
                    </Ellipse.Fill>
                  </Ellipse>
                  <StackPanel Grid.Column="1"
                              Spacing="2"
                              VerticalAlignment="Center">
                    <TextBlock Text="{Binding AccountUserName}"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <TextBlock Classes="muted"
                               Text="Bilibili 帳號狀態"
                               FontSize="11" />
                  </StackPanel>
                </Grid>
                <WrapPanel Grid.Column="1"
                           ItemSpacing="20"
                           LineSpacing="6"
                           VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="muted" Text="等級" FontSize="12" />
                    <TextBlock Text="{Binding AccountLevelText}"
                               FontSize="13"
                               FontWeight="SemiBold" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="muted" Text="經驗" FontSize="12" />
                    <TextBlock Text="{Binding AccountExperienceText}"
                               FontSize="13"
                               FontWeight="SemiBold" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="muted" Text="硬幣" FontSize="12" />
                    <TextBlock Text="{Binding AccountCoinsText}"
                               FontSize="13"
                               FontWeight="SemiBold" />
                  </StackPanel>
                </WrapPanel>
                <Grid Grid.Row="1"
                      Grid.ColumnSpan="2"
                      ColumnDefinitions="Auto,*"
                      ColumnSpacing="8"
                      IsVisible="{Binding HasAccountSignature}">
                  <TextBlock Classes="muted"
                             Text="個人簡介"
                             FontSize="12" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding AccountSignature}"
                             FontSize="12"
                             TextWrapping="Wrap" />
                </Grid>
                <Grid Grid.Row="2"
                      Grid.ColumnSpan="2"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="8"
                      IsVisible="{Binding HasLatestDynamic}">
                  <Separator />
                  <Grid Grid.Row="1"
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="12">
                    <Image Width="112"
                           Height="63"
                           Stretch="UniformToFill"
                           Source="{Binding LatestDynamicCover}"
                           IsVisible="{Binding HasLatestDynamicCover}" />
                    <StackPanel Grid.Column="1"
                                Spacing="4"
                                VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="最新動態"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <TextBlock Classes="muted"
                                   Text="{Binding LatestDynamicType}"
                                   FontSize="11" />
                        <TextBlock Classes="muted"
                                   Text="{Binding LatestDynamicPublishedText}"
                                   FontSize="11" />
                      </StackPanel>
                      <TextBlock Text="{Binding LatestDynamicText}"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 TextTrimming="CharacterEllipsis"
                                 MaxHeight="38" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Classes="secondary"
                            Content="開啟"
                            VerticalAlignment="Center"
                            Command="{Binding OpenLatestDynamicCommand}" />
                  </Grid>
                </Grid>
                <Grid Grid.Row="3"
                      Grid.ColumnSpan="2"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="8"
                      IsVisible="{Binding HasLatestSubmission}">
                  <Separator />
                  <Grid Grid.Row="1"
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="12">
                    <Image Width="112"
                           Height="63"
                           Stretch="UniformToFill"
                           Source="{Binding LatestSubmissionCover}"
                           IsVisible="{Binding HasLatestSubmissionCover}" />
                    <StackPanel Grid.Column="1"
                                Spacing="4"
                                VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding LatestSubmissionHeading}"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <TextBlock Classes="muted"
                                   Text="{Binding LatestSubmissionMetaText}"
                                   FontSize="11" />
                      </StackPanel>
                      <TextBlock Text="{Binding LatestSubmissionTitle}"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 TextTrimming="CharacterEllipsis"
                                 MaxHeight="38" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Classes="secondary"
                            Content="播放"
                            VerticalAlignment="Center"
                            Command="{Binding OpenLatestSubmissionCommand}" />
                  </Grid>
                </Grid>
                <Grid Grid.Row="4"
                      Grid.ColumnSpan="2"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="8"
                      IsVisible="{Binding HasFavoriteInfo}">
                  <Separator />
                  <Grid Grid.Row="1"
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="12">
                    <Image Width="96"
                           Height="54"
                           Stretch="UniformToFill"
                           Source="{Binding LatestFavoriteCover}"
                           IsVisible="{Binding HasLatestFavoriteCover}" />
                    <StackPanel Grid.Column="1"
                                Spacing="3"
                                VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding FavoriteHeading}"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <TextBlock Classes="muted"
                                   Text="{Binding FavoriteFolderText}"
                                   FontSize="11" />
                      </StackPanel>
                      <TextBlock Text="{Binding LatestFavoriteTitle}"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 TextTrimming="CharacterEllipsis"
                                 MaxHeight="34" />
                      <TextBlock Classes="muted"
                                 Text="{Binding LatestFavoriteMetaText}"
                                 FontSize="11" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Classes="secondary"
                            Content="播放"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding HasLatestFavoriteLink}"
                            Command="{Binding OpenLatestFavoriteCommand}" />
                  </Grid>
                </Grid>
                <Grid Grid.Row="5"
                      Grid.ColumnSpan="2"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="8"
                      IsVisible="{Binding HasBangumiFollow}">
                  <Separator />
                  <Grid Grid.Row="1"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="18">
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="10"
                          IsVisible="{Binding HasLatestAnime}">
                      <Image Width="42"
                             Height="58"
                             Stretch="UniformToFill"
                             Source="{Binding LatestAnimeCover}"
                             IsVisible="{Binding HasLatestAnimeCover}" />
                      <StackPanel Grid.Column="1"
                                  Spacing="3"
                                  VerticalAlignment="Center">
                        <TextBlock Text="{Binding AnimeHeading}"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LatestAnimeTitle}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="34" />
                        <TextBlock Classes="muted"
                                   Text="{Binding LatestAnimeProgress}"
                                   FontSize="11" />
                      </StackPanel>
                      <Button Grid.Column="2"
                              Classes="secondary"
                              Content="開啟"
                              VerticalAlignment="Center"
                              IsEnabled="{Binding HasLatestAnimeLink}"
                              Command="{Binding OpenLatestAnimeCommand}" />
                    </Grid>
                    <Grid Grid.Column="1"
                          ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="10"
                          IsVisible="{Binding HasLatestDrama}">
                      <Image Width="42"
                             Height="58"
                             Stretch="UniformToFill"
                             Source="{Binding LatestDramaCover}"
                             IsVisible="{Binding HasLatestDramaCover}" />
                      <StackPanel Grid.Column="1"
                                  Spacing="3"
                                  VerticalAlignment="Center">
                        <TextBlock Text="{Binding DramaHeading}"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LatestDramaTitle}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="34" />
                        <TextBlock Classes="muted"
                                   Text="{Binding LatestDramaProgress}"
                                   FontSize="11" />
                      </StackPanel>
                      <Button Grid.Column="2"
                              Classes="secondary"
                              Content="開啟"
                              VerticalAlignment="Center"
                              IsEnabled="{Binding HasLatestDramaLink}"
                              Command="{Binding OpenLatestDramaCommand}" />
                    </Grid>
                  </Grid>
                </Grid>
                <Grid Grid.Row="6"
                      Grid.ColumnSpan="2"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="8"
                      IsVisible="{Binding HasHomepageRecommendation}">
                  <Separator />
                  <Grid Grid.Row="1"
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="12">
                    <Image Width="96"
                           Height="54"
                           Stretch="UniformToFill"
                           Source="{Binding HomepageRecommendationCover}"
                           IsVisible="{Binding HasHomepageRecommendationCover}" />
                    <StackPanel Grid.Column="1"
                                Spacing="3"
                                VerticalAlignment="Center">
                      <TextBlock Text="首頁推薦"
                                 FontSize="12"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="{Binding HomepageRecommendationTitle}"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 TextTrimming="CharacterEllipsis"
                                 MaxHeight="34" />
                      <TextBlock Classes="muted"
                                 Text="{Binding HomepageRecommendationMetaText}"
                                 FontSize="11" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Classes="secondary"
                            Content="播放"
                            VerticalAlignment="Center"
                            Command="{Binding OpenHomepageRecommendationCommand}" />
                  </Grid>
                </Grid>
                <Grid Grid.Row="7"
                      Grid.ColumnSpan="2"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="8"
                      IsVisible="{Binding HasDynamicFeed}">
                  <Separator />
                  <Grid Grid.Row="1"
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="12">
                    <Image Width="96"
                           Height="54"
                           Stretch="UniformToFill"
                           Source="{Binding DynamicFeedCover}"
                           IsVisible="{Binding HasDynamicFeedCover}" />
                    <StackPanel Grid.Column="1"
                                Spacing="3"
                                VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="動態首頁"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <TextBlock Classes="muted"
                                   Text="{Binding DynamicFeedHeading}"
                                   FontSize="11" />
                        <TextBlock Classes="muted"
                                   Text="{Binding DynamicFeedMetaText}"
                                   FontSize="11" />
                      </StackPanel>
                      <TextBlock Text="{Binding DynamicFeedText}"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 TextTrimming="CharacterEllipsis"
                                 MaxHeight="38" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Classes="secondary"
                            Content="開啟"
                            VerticalAlignment="Center"
                            Command="{Binding OpenDynamicFeedCommand}" />
                  </Grid>
                </Grid>
                <Grid Grid.Row="8"
                      Grid.ColumnSpan="2"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="8"
                      IsVisible="{Binding HasBangumiRecommendation}">
                  <Separator />
                  <Grid Grid.Row="1"
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="12">
                    <Image Width="42"
                           Height="58"
                           Stretch="UniformToFill"
                           Source="{Binding BangumiRecommendationCover}"
                           IsVisible="{Binding HasBangumiRecommendationCover}" />
                    <StackPanel Grid.Column="1"
                                Spacing="3"
                                VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="番劇推薦"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <TextBlock Classes="muted"
                                   Text="{Binding BangumiRecommendationMetaText}"
                                   FontSize="11" />
                      </StackPanel>
                      <TextBlock Text="{Binding BangumiRecommendationTitle}"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 TextTrimming="CharacterEllipsis"
                                 MaxHeight="34" />
                      <TextBlock Classes="muted"
                                 Text="{Binding BangumiRecommendationSubtitle}"
                                 FontSize="11"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Classes="secondary"
                            Content="播放"
                            VerticalAlignment="Center"
                            Command="{Binding OpenBangumiRecommendationCommand}" />
                  </Grid>
                </Grid>
                <Grid Grid.Row="9"
                      Grid.ColumnSpan="2"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="8"
                      IsVisible="{Binding HasLiveRecommendation}">
                  <Separator />
                  <Grid Grid.Row="1"
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="12">
                    <Image Width="96"
                           Height="54"
                           Stretch="UniformToFill"
                           Source="{Binding LiveRecommendationCover}"
                           IsVisible="{Binding HasLiveRecommendationCover}" />
                    <StackPanel Grid.Column="1"
                                Spacing="3"
                                VerticalAlignment="Center">
                      <TextBlock Text="直播推薦"
                                 FontSize="12"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="{Binding LiveRecommendationTitle}"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 TextTrimming="CharacterEllipsis"
                                 MaxHeight="34" />
                      <TextBlock Classes="muted"
                                 Text="{Binding LiveRecommendationMetaText}"
                                 FontSize="11"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Classes="secondary"
                            Content="進入"
                            VerticalAlignment="Center"
                            Command="{Binding OpenLiveRecommendationCommand}" />
                  </Grid>
                </Grid>
                <Grid Grid.Row="10"
                      Grid.ColumnSpan="2"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="8"
                      IsVisible="{Binding HasPopularVideo}">
                  <Separator />
                  <Grid Grid.Row="1"
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="12">
                    <Image Width="96"
                           Height="54"
                           Stretch="UniformToFill"
                           Source="{Binding PopularVideoCover}"
                           IsVisible="{Binding HasPopularVideoCover}" />
                    <StackPanel Grid.Column="1"
                                Spacing="3"
                                VerticalAlignment="Center">
                      <TextBlock Text="綜合熱門"
                                 FontSize="12"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="{Binding PopularVideoTitle}"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 TextTrimming="CharacterEllipsis"
                                 MaxHeight="34" />
                      <TextBlock Classes="muted"
                                 Text="{Binding PopularVideoMetaText}"
                                 FontSize="11"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Classes="secondary"
                            Content="播放"
                            VerticalAlignment="Center"
                            Command="{Binding OpenPopularVideoCommand}" />
                  </Grid>
                </Grid>
                <Grid Grid.Row="11"
                      Grid.ColumnSpan="2"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="8"
                      IsVisible="{Binding HasRankingVideo}">
                  <Separator />
                  <Grid Grid.Row="1"
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="12">
                    <Image Width="96"
                           Height="54"
                           Stretch="UniformToFill"
                           Source="{Binding RankingVideoCover}"
                           IsVisible="{Binding HasRankingVideoCover}" />
                    <StackPanel Grid.Column="1"
                                Spacing="3"
                                VerticalAlignment="Center">
                      <TextBlock Text="{Binding RankingVideoHeading}"
                                 FontSize="12"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="{Binding RankingVideoTitle}"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 TextTrimming="CharacterEllipsis"
                                 MaxHeight="34" />
                      <TextBlock Classes="muted"
                                 Text="{Binding RankingVideoMetaText}"
                                 FontSize="11"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Classes="secondary"
                            Content="播放"
                            VerticalAlignment="Center"
                            Command="{Binding OpenRankingVideoCommand}" />
                  </Grid>
                </Grid>
                <Grid Grid.Row="12"
                      Grid.ColumnSpan="2"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="8"
                      IsVisible="{Binding HasHotSearch}">
                  <Separator />
                  <Grid Grid.Row="1"
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="12">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Bilibili 熱搜"
                                 FontSize="12"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="{Binding HotSearchSummary}"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 LineHeight="20" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="secondary"
                            Content="搜尋第 1 名"
                            VerticalAlignment="Center"
                            Command="{Binding OpenHotSearchCommand}" />
                  </Grid>
                </Grid>
              </Grid>
            </Border>
            </ScrollViewer>

            <Grid DockPanel.Dock="Bottom" Margin="12,12,12,4">
              <StackPanel Spacing="8">
                <WrapPanel ItemSpacing="6" LineSpacing="6">
                  <Button Classes="secondary"
                          Content="{Binding RevealButtonText}"
                          Command="{Binding ToggleRevealCommand}" />
                  <Button Classes="primary"
                          Content="驗證登入"
                          Command="{Binding VerifyLoginCommand}" />
                </WrapPanel>
                <WrapPanel ItemSpacing="2" LineSpacing="4">
                  <Button Classes="ghost"
                          Content="複製環境變數"
                          Command="{Binding CopyAllEnvCommand}" />
                  <Button Classes="ghost"
                          Content="複製 Secrets"
                          Command="{Binding CopyAllSecretsCommand}" />
                  <Button Classes="ghost"
                          Content="複製 Cookie 字串"
                          Command="{Binding CopyCookieHeaderCommand}" />
                  <Button Classes="ghost"
                          Content="PowerShell"
                          Command="{Binding CopyPowerShellCommand}" />
                  <Button Classes="ghost"
                          Content="bash"
                          Command="{Binding CopyBashCommand}" />
                </WrapPanel>
                <TextBlock Classes="muted"
                           FontSize="11"
                           Text="SESSDATA 保持檔案原始值，不要 URL 解碼。更新 Secrets 無法讀回舊值。"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Grid>

            <Grid>
              <StackPanel Margin="16"
                          Spacing="8"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsVisible="{Binding !HasResult}">
                <TextBlock Text="還沒有 Cookie"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Classes="muted"
                           FontSize="13"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="320"
                           Text="把瀏覽器匯出的 cookies.txt 拖到左邊，或按瀏覽。" />
              </StackPanel>

              <ItemsControl ItemsSource="{Binding Fields}"
                            Margin="12,4"
                            IsVisible="{Binding HasResult}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CookieFieldViewModel">
                    <Border Classes="row">
                      <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding EnvName}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Classes="muted"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Text="{Binding SecretHint}" />
                          </StackPanel>
                          <Button Grid.Column="1"
                                  Classes="secondary"
                                  Content="複製"
                                  Command="{Binding CopyCommand}"
                                  IsEnabled="{Binding HasValue}" />
                        </Grid>
                        <TextBox Classes="mono"
                                 Text="{Binding DisplayValue}"
                                 IsReadOnly="True"
                                 AcceptsReturn="False" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                          <TextBlock Classes="muted" FontSize="12" Text="{Binding MetaText}" />
                          <TextBlock Classes="warn"
                                     FontSize="12"
                                     Text="即將到期"
                                     IsVisible="{Binding IsExpiringSoon}" />
                          <TextBlock Classes="error"
                                     FontSize="12"
                                     Text="已過期"
                                     IsVisible="{Binding IsExpired}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
