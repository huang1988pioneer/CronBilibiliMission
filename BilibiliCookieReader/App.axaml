<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BilibiliCookieReader.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#FB7299" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E85A86" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#5F6368" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#B42318" />
    </Style>
    <Style Selector="TextBlock.ok">
      <Setter Property="Foreground" Value="#1B7A4A" />
    </Style>
    <Style Selector="TextBox.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Border.expiry">
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="22" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.expiry.ok">
      <Setter Property="Background" Value="#E8F5EE" />
      <Setter Property="BorderBrush" Value="#B7D7C4" />
    </Style>
    <Style Selector="Border.expiry.soon">
      <Setter Property="Background" Value="#FFF6E5" />
      <Setter Property="BorderBrush" Value="#E8C37A" />
    </Style>
    <Style Selector="Border.expiry.urgent">
      <Setter Property="Background" Value="#FFF1E8" />
      <Setter Property="BorderBrush" Value="#F0A36C" />
    </Style>
    <Style Selector="Border.expiry.expired">
      <Setter Property="Background" Value="#FDECEA" />
      <Setter Property="BorderBrush" Value="#F5C2C0" />
    </Style>
  </Application.Styles>
</Application>
